/* pages/sentences/sentences.wxss */

.page {
  padding: 24rpx 32rpx;
  padding-bottom: 160rpx;
  min-height: 100vh;
}

/* 分组 */
.group {
  margin-bottom: 40rpx;
}

.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.group-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.group-count {
  font-size: 24rpx;
  color: #999;
}

/* 卡片 */
.card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border-left: 8rpx solid transparent;
}

.card--playing {
  background-color: #e8f4fd;
  box-shadow: 0 4rpx 20rpx rgba(74, 144, 217, 0.15);
  border-left-color: #4A90D9;
}

.card-content {
  display: flex;
  align-items: flex-start;
  flex: 1;
  margin-right: 20rpx;
}

.card-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: #4A90D9;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  margin-top: 2rpx;
}

.card-text {
  flex: 1;
}

.card-en {
  display: block;
  font-size: 32rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-word;
}

.card-zh {
  display: block;
  font-size: 30rpx;
  color: #555;
  line-height: 1.5;
  word-break: break-word;
}

.card-blank {
  display: block;
  font-size: 28rpx;
  color: #bbb;
  font-style: italic;
}

/* 操作区（开关 + 播放） */
.card-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 16rpx;
}

.learned-switch {
  transform: scale(0.8);
}

/* 播放按钮 */
.card-play-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #4A90D9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-play-btn--playing {
  background-color: #e74c3c;
}

.play-icon {
  color: #fff;
  font-size: 26rpx;
}

/* 底部停止按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
}

.stop-btn {
  height: 88rpx;
  border-radius: 44rpx;
  background-color: #e74c3c;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}
