<!--pages/review/review.wxml-->
<view class="page">
  <view class="header">
    <text class="header-title">今日复习</text>
    <text class="header-subtitle">每天听三句，坚持有进步</text>
  </view>

  <view class="empty-state" wx:if="{{cards.length === 0}}">
    <text class="empty-text">还没有已学习的句子</text>
    <text class="empty-hint">去「全部句子」页面开启复习开关吧</text>
  </view>

  <view class="card-list" wx:else>
    <view
      class="card {{playingId === item.id ? 'card--playing' : ''}}"
      wx:for="{{cards}}"
      wx:key="id"
    >
      <view class="card-content" data-id="{{item.id}}" bindtap="onToggleText">
        <view class="card-index">{{index + 1}}</view>
        <view class="card-text">
          <text class="card-en" wx:if="{{displayMode[item.id] === 1}}">{{item.en}}</text>
          <text class="card-zh" wx:elif="{{displayMode[item.id] === 2}}">{{item.zh}}</text>
          <text class="card-blank" wx:else>点击显示</text>
        </view>
      </view>
      <view class="card-controls">
        <view class="speed-btn" bindtap="onSpeedTap">
          <text>{{playbackRate === 1 ? 'x1.0' : 'x' + playbackRate}}</text>
        </view>
        <view
          class="card-play-btn {{playingId === item.id ? 'card-play-btn--playing' : ''}}"
          data-id="{{item.id}}"
          bindtap="onPlay"
        >
          <text class="play-icon">{{playingId === item.id ? '■' : '▶'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer" wx:if="{{playingId}}">
    <view class="stop-btn" bindtap="onStop">
      <text>停止播放</text>
    </view>
  </view>
</view>
