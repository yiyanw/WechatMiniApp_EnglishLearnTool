/* pages/review/review.wxss */

.page {
  padding: 40rpx 32rpx;
  padding-bottom: 160rpx;
  min-height: 100vh;
}

/* 头部 */
.header {
  margin-bottom: 48rpx;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.header-subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 36rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #999;
}

/* 卡片列表 */
.card-list {
  display: flex;
  flex-direction: column;
}

/* 单张卡片 */
.card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
  border-left: 8rpx solid transparent;
}

.card--playing {
  background-color: #e8f4fd;
  box-shadow: 0 4rpx 20rpx rgba(74, 144, 217, 0.15);
  border-left-color: #4A90D9;
}

/* 卡片内容区（序号 + 文本） */
.card-content {
  display: flex;
  align-items: flex-start;
  flex: 1;
  margin-right: 24rpx;
}

.card-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #4A90D9;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
  margin-top: 4rpx;
}

.card-text {
  flex: 1;
}

.card-en {
  font-size: 34rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-word;
}

.card-zh {
  font-size: 32rpx;
  color: #555;
  line-height: 1.6;
  word-break: break-word;
}

.card-blank {
  font-size: 30rpx;
  color: #bbb;
  font-style: italic;
}

/* 播放控制区（倍速 + 播放按钮） */
.card-controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

/* 播放按钮 */
.card-play-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #4A90D9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-play-btn--playing {
  background-color: #e74c3c;
}

.play-icon {
  color: #fff;
  font-size: 28rpx;
}

/* 底部停止按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
}

.stop-btn {
  height: 88rpx;
  border-radius: 44rpx;
  background-color: #e74c3c;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}
