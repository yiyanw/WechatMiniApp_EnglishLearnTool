/* app.wxss */
page {
  background-color: #f0f4f8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  box-sizing: border-box;
}

view, text {
  box-sizing: border-box;
}

.speed-btn {
  width: 80rpx;
  padding: 8rpx 0;
  border-radius: 20rpx;
  background-color: #f0f0f0;
  font-size: 24rpx;
  color: #666;
  text-align: center;
}
